---
# Copy to secrets.yml and fill in real values, then encrypt:
#   ansible-vault encrypt ansible/group_vars/secrets.yml
# Decrypt to edit:
#   ansible-vault decrypt ansible/group_vars/secrets.yml
# Run playbooks with:
#   ansible-playbook ... --ask-vault-pass

deployment_mode: lan
basicauth_users: "CHANGEME $2a$14$REPLACE_WITH_REAL_BCRYPT_HASH"
