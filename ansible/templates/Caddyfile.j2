{% if deployment_mode == "lan" %}
{{ ansible_default_ipv4.address | default('localhost') }} {
{% else %}
{{ domain }} {
{% endif %}
    log {
        output file /var/log/caddy/access.log {
            format console
        }
    }
    basic_auth * {
        {$BASICAUTH_USERS}
    }
    reverse_proxy streamlit:8501
}
