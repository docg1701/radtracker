# Secrets — NEVER copy into the image
.env

# Git — huge, not needed at runtime
.git/
.gitignore

# Data — bind-mounted at runtime, must not be baked in
data/
backups/

# Caddy runtime dirs (generated by Docker, never in the app image)
caddy_data/
caddy_config/
caddy_logs/

# Lock files (not needed at runtime)
uv.lock

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Dev/test artifacts
temp/
tests/
docs/
.coverage
htmlcov/

# Deployment files (not needed inside the app container)
docker-compose.yml
Caddyfile
.env.example
.streamlit/secrets.toml
ansible/
scripts/

# OS/IDE
.DS_Store
.vscode/
.idea/
*.swp
