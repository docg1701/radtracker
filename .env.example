# Domain — set to a real domain for internet mode, or leave default for LAN
# LAN mode: Caddy listens on :80 with plain HTTP (no TLS)
# Internet mode: Caddy auto-provisions Let's Encrypt certificate
DOMAIN=localhost

# BasicAuth users: generate hash with:
#   docker run --rm caddy:2.9-alpine caddy hash-password --plaintext "yourpassword"
# Format: "username hash" (space-separated, NO colon)
# IMPORTANT: Escape $ as $$ — Docker's env_file parser expands bare $ as variables.
# Example: if caddy outputs $2a$14$..., write it as $$2a$$14$$...
BASICAUTH_USERS=admin $$2a$$14$$placeholderhashreplaceme
