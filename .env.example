# Domain — set to a real domain for internet mode, or the LAN IP for LAN mode
# LAN mode: Caddy serves plain HTTP (no TLS)
# Internet mode: Caddy auto-provisions Let's Encrypt certificate
DOMAIN=localhost

# Container timezone
TZ=America/Fortaleza

# Note: authentication is app-level (login + TOTP 2FA, data/auth.json) —
# there is no Caddy basic_auth and no BASICAUTH_USERS variable anymore.
