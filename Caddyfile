{$DOMAIN:localhost} {
    log {
        output file /var/log/caddy/access.log {
            format console
        }
    }

    # Prevent browser from caching HTML pages — critical for Streamlit.
    # Streamlit regenerates JS chunk hashes on restart, so a stale cached
    # HTML page references non-existent JS files, causing:
    #   TypeError: Failed to fetch dynamically imported module
    # The route block ensures headers are applied in literal order:
    # generic no-cache first, then /static/* overrides with immutable.
    route {
        header           Cache-Control "no-cache, max-age=0, must-revalidate"
        header /static/* Cache-Control "public, max-age=31536000, immutable"
    }
    header -Server

    reverse_proxy streamlit:8501
}
